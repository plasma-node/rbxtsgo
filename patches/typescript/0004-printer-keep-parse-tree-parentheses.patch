+	// parentheses here. The caller adds any that a synthesized parent needs around a parse tree child.
+	KeepParseTreeParentheses bool
 }
 
 type PrintHandlers struct {
@@ -3220,7 +3225,8 @@ func (p *Printer) emitExpressionNoASI(node *ast.Expression, precedence ast.Opera
 }
 
 func (p *Printer) emitExpression(node *ast.Expression, precedence ast.OperatorPrecedence) {
-	parens := ast.GetExpressionPrecedence(ast.SkipPartiallyEmittedExpressions(node)) < precedence
+	parens := ast.GetExpressionPrecedence(ast.SkipPartiallyEmittedExpressions(node)) < precedence &&
+		!(p.Options.KeepParseTreeParentheses && !ast.NodeIsSynthesized(node))
 	if parens {
 		p.writePunctuation("(")
 	}
