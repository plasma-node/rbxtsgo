--- a/tsc/internal/printer/printer.go
+++ b/tsc/internal/printer/printer.go
@@ -50,6 +50,11 @@ type PrinterOptions struct {
 	// StripInternal                 bool
 	PreserveSourceNewlines        bool
 	TerminateUnterminatedLiterals bool // !!!
+	// rbxtsgo: a parse tree already spells every parenthesis it needs, as a ParenthesizedExpression. TS 5.5.3's printer
+	// adds none to it, while this one compares precedences and writes (a!).b and (new A)?.c for a!.b and new A?.c. The
